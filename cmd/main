#!/usr/bin/env bash
set -euo pipefail
APP_DIR="${TRIM_APPDEST:?TRIM_APPDEST is required}"
PKGVAR="${TRIM_PKGVAR:?TRIM_PKGVAR is required}"
APP_VOL="${TRIM_APPDEST_VOL:?TRIM_APPDEST_VOL is required}"
BIN="$APP_DIR/bin/fnsdownload"
PID_FILE="$PKGVAR/run/fnsdownload.pid"
LOG_FILE="$PKGVAR/log/app.log"
DATA_DIR="$PKGVAR/data"
DOWNLOAD_DIR="$APP_VOL/@appshare/fnsdownload/downloads"
PORT="${wizard_port:-8088}"
mkdir -p "$PKGVAR/run" "$PKGVAR/log" "$DATA_DIR" "$DOWNLOAD_DIR"
chmod 700 "$PKGVAR/run" "$DATA_DIR"
is_running() {
  [[ -s "$PID_FILE" ]] || return 1
  local pid; pid="$(cat "$PID_FILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}
case "${1:-}" in
 start)
  is_running && exit 0
  [[ -x "$BIN" ]] || { echo "Go binary missing: $BIN" >&2; exit 1; }
  export PORT DATA_DIR DOWNLOAD_DIR HOME="$PKGVAR"
  nohup "$BIN" >>"$LOG_FILE" 2>&1 </dev/null &
  echo $! >"$PID_FILE"
  sleep 1
  is_running || { rm -f "$PID_FILE"; echo "service failed; inspect $LOG_FILE" >&2; exit 1; }
  ;;
 stop)
  if is_running; then
   pid="$(cat "$PID_FILE")"; kill "$pid" 2>/dev/null || true
   for _ in {1..20}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
   kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  ;;
 status) is_running && exit 0; exit 3 ;;
 *) echo "usage: $0 {start|stop|status}" >&2; exit 2 ;;
esac
