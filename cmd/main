#!/usr/bin/env bash
set -euo pipefail
APP_DEST="${TRIM_APPDEST:?TRIM_APPDEST is required}"
PKGVAR="${TRIM_PKGVAR:?TRIM_PKGVAR is required}"
BIN="$APP_DEST/server/fnsdownload-amd64"
SOCKET="$APP_DEST/app.sock"
PID_FILE="$PKGVAR/fnsdownload.pid"
LOG_DIR="$PKGVAR/logs"
LOG_FILE="$LOG_DIR/app.log"
report_error() {
  printf '%s\n' "$1" >&2
  if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then printf '%s\n' "$1" >"$TRIM_TEMP_LOGFILE"; fi
}
is_running() {
  [[ -s "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}
case "${1:-}" in
  start)
    mkdir -p "$PKGVAR" "$LOG_DIR"
    if is_running && [[ -S "$SOCKET" ]]; then exit 0; fi
    rm -f "$PID_FILE" "$SOCKET"
    [[ -x "$BIN" ]] || { report_error "Missing service binary: $BIN"; exit 1; }
    [[ -s "$APP_DEST/www/index.html" ]] || { report_error "Missing UI: $APP_DEST/www/index.html"; exit 1; }
    [[ -w "$APP_DEST" ]] || { report_error "Cannot write gateway socket in $APP_DEST"; exit 1; }
    export DATA_DIR="$PKGVAR/data"
    export DOWNLOAD_DIR="$PKGVAR/data/downloads"
    export UI_DIR="$APP_DEST/www"
    export HOME="${TRIM_PKGHOME:-$PKGVAR}"
    export TRIM_APPDEST TRIM_PKGVAR
    nohup "$BIN" >>"$LOG_FILE" 2>&1 </dev/null &
    echo "$!" >"$PID_FILE"
    for _ in {1..40}; do
      if is_running && [[ -S "$SOCKET" ]]; then exit 0; fi
      if ! is_running; then report_error "Service exited during startup. Check $LOG_FILE"; rm -f "$PID_FILE"; exit 1; fi
      sleep 0.25
    done
    report_error "Service did not create gateway socket. Check $LOG_FILE"
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE" "$SOCKET"
    exit 1
    ;;
  stop)
    if is_running; then
      pid="$(cat "$PID_FILE")"
      kill -TERM "$pid" 2>/dev/null || true
      for _ in {1..40}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
      kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE" "$SOCKET"
    ;;
  status) if is_running && [[ -S "$SOCKET" ]]; then exit 0; fi; exit 3 ;;
  *) report_error "Usage: $0 {start|stop|status}"; exit 1 ;;
esac
