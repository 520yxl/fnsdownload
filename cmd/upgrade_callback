#!/usr/bin/env bash
set -euo pipefail
: "${TRIM_APPDEST:?TRIM_APPDEST is required}"
: "${TRIM_PKGVAR:?TRIM_PKGVAR is required}"
: "${TRIM_USERNAME:?TRIM_USERNAME is required}"
: "${TRIM_GROUPNAME:?TRIM_GROUPNAME is required}"
[[ -x "$TRIM_APPDEST/server/fnsdownload-amd64" ]] || exit 1
mkdir -p "$TRIM_PKGVAR/data/downloads" "$TRIM_PKGVAR/logs"
if [[ "$(id -u)" -eq 0 ]]; then
  chown "$TRIM_USERNAME:$TRIM_GROUPNAME" "$TRIM_PKGVAR"
  chmod 750 "$TRIM_PKGVAR"
  chown -R "$TRIM_USERNAME:$TRIM_GROUPNAME" "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/logs"
fi
chmod 700 "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/logs"
