#!/usr/bin/env bash
set -euo pipefail
fail() {
  printf '%s\n' "$1" >&2
  if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then printf '%s\n' "$1" >"$TRIM_TEMP_LOGFILE"; fi
  exit 1
}
ARCH="${TRIM_SYS_ARCH:-$(uname -m)}"
[[ "$ARCH" == "x86_64" || "$ARCH" == "amd64" ]] || fail "MoxYi Download only supports x86_64 fnOS. Detected: $ARCH"
[[ -n "${TRIM_APPDEST:-}" ]] || fail "fnOS did not provide TRIM_APPDEST."
[[ -n "${TRIM_PKGVAR:-}" ]] || fail "fnOS did not provide TRIM_PKGVAR."
exit 0
