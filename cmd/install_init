#!/usr/bin/env bash
set -euo pipefail
# install_init runs before app files are installed. Do not require TRIM_APPDEST
# or TRIM_PKGVAR to exist at this stage.
if [[ "${TRIM_SYS_ARCH:-$(uname -m)}" != "x86_64" && "${TRIM_SYS_ARCH:-$(uname -m)}" != "amd64" && "${TRIM_SYS_ARCH:-$(uname -m)}" != "x86" ]]; then
  printf '%s\n' "MoxYi Download requires x86_64 fnOS." >&2
  if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then printf '%s\n' "MoxYi Download requires x86_64 fnOS." >"$TRIM_TEMP_LOGFILE"; fi
  exit 1
fi
exit 0
