#!/usr/bin/env bash
set -euo pipefail
: "${TRIM_PKGVAR:?TRIM_PKGVAR is required}"
: "${TRIM_APPDEST:?TRIM_APPDEST is required}"
: "${TRIM_APPDEST_VOL:?TRIM_APPDEST_VOL is required}"
mkdir -p "${TRIM_PKGVAR}/data" "${TRIM_APPDEST}/target" "${TRIM_APPDEST_VOL}/@appshare/fnsdownload/downloads"
chmod 700 "${TRIM_PKGVAR}/data"
chmod +x "${TRIM_APPDEST}/server/fnsdownload-amd64"
test -s "${TRIM_APPDEST}/ui/index.html"
