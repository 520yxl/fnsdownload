#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf '%s\n' "$1" >&2
  if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then printf '%s\n' "$1" >"$TRIM_TEMP_LOGFILE"; fi
  exit 1
}

: "${TRIM_APPDEST:?TRIM_APPDEST is required}"
: "${TRIM_PKGVAR:?TRIM_PKGVAR is required}"
: "${TRIM_USERNAME:?TRIM_USERNAME is required}"
: "${TRIM_GROUPNAME:?TRIM_GROUPNAME is required}"

ARCH="${TRIM_SYS_ARCH:-$(uname -m)}"
[[ "$ARCH" == "x86_64" || "$ARCH" == "amd64" ]] || fail "MoxYi Download only supports x86_64 fnOS."
[[ -x "$TRIM_APPDEST/server/fnsdownload-amd64" ]] || fail "Missing Go service binary in target/server."
[[ -s "$TRIM_APPDEST/ui/index.html" ]] || fail "Missing desktop Web UI in target/ui."

mkdir -p "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/logs"
chmod 700 "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/logs"

# TRIM_APPDEST is the installed target directory. The unified gateway socket
# must be created directly inside this directory as app.sock.
if [[ "$(id -u)" -eq 0 ]]; then
  chown root:"$TRIM_GROUPNAME" "$TRIM_APPDEST"
  chmod 1770 "$TRIM_APPDEST"
fi
[[ -w "$TRIM_APPDEST" ]] || fail "The package user cannot create target/app.sock. Check fnOS target directory permissions."
